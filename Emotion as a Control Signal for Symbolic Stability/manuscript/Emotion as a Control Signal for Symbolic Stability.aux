\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Homeostatic Baseline vs. Stress-Induced Perturbation. (A) Baseline SEC drift remains within the 0.112–0.186 range over 15+ cycles, indicating high system stability without external stimuli. (B) Under stress, drift exceeds the 0.3 threshold, triggering the "Mode Selector" response. (C) Cognitive Integrity benchmarks confirm that even during high-drift events, the mean emotional stability remains at 87\%, ensuring the system does not enter an unrecoverable state.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:homeostasis_baseline}{{3}{9}{Homeostatic Baseline vs. Stress-Induced Perturbation. (A) Baseline SEC drift remains within the 0.112–0.186 range over 15+ cycles, indicating high system stability without external stimuli. (B) Under stress, drift exceeds the 0.3 threshold, triggering the "Mode Selector" response. (C) Cognitive Integrity benchmarks confirm that even during high-drift events, the mean emotional stability remains at 87\%, ensuring the system does not enter an unrecoverable state}{figure.caption.7}{}}
